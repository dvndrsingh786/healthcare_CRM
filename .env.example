# Copy this file to .env and fill in the values. Never commit .env.
# Names only here: no real secrets.

ENVIRONMENT=development

# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=healthcare_crm
DB_USER=postgres
DB_PASSWORD=

# At least 32 random characters. Signs short-lived document links.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Token lifetimes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_RESET_MINUTES=30

# Abuse controls
LOGIN_RATE_LIMIT_PER_MINUTE=5
APP_RATE_LIMIT_PER_MINUTE=120

# Comma-separated browser origins allowed to call the API (empty = none)
CORS_ORIGINS=

# Private file storage (local adapter). Must NOT be a publicly served folder.
STORAGE_DIR=
MAX_UPLOAD_BYTES=10485760
SIGNED_URL_SECONDS=300

# Notification outbox
NOTIFICATION_MAX_ATTEMPTS=5
